{
  "name": "@ikary/worker",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "IKARY Worker — transactional outbox poller and pluggable event dispatcher",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build":         "tsup src/main.ts --format esm --clean --external reflect-metadata",
    "start":         "node dist/main.js",
    "start:dev":     "tsx watch src/main.ts",
    "typecheck":     "tsc --noEmit",
    "test":          "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ikary/cell-contract":     "^0.3.0",
    "@ikary/cell-runtime-core": "^0.3.0",
    "@ikary/system-db-core":    "^0.3.0",
    "@nestjs/common":           "^11.0.0",
    "@nestjs/core":             "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule":         "^4.0.0",
    "amqplib":                  "^0.10.4",
    "reflect-metadata":         "^0.2.2",
    "rxjs":                     "^7.8.1",
    "zod":                      "^3.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node":    "^20.0.0",
    "tsup":           "^8.0.2",
    "tsx":            "^4.19.0",
    "typescript":     "^5.5.3",
    "vitest":         "^3.0.0"
  },
  "engines": { "node": ">=20" }
}
